# Server-only. Pick an available model from your Anthropic Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Fo uses per-user Wajo OAuth. Generate the encryption key once and keep it stable.
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
FO_TOKEN_ENCRYPTION_KEY=
# Required in production; use the canonical HTTPS origin without a trailing path.
DAYMADE_APP_URL=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only key (sb_secret_...). Legacy service-role key is also supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
